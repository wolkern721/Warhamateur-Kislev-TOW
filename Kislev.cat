    <profile name="Plateformes de Tirs" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="3c18-b623-c174-4998">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">Une figurine avec cet équipement pourra toujours faire un Mouvement et tirer, même équipé d&apos;une arme avec la règle spéciale Mouvement ou Tir. Notez que le malus pour Mouvement, de -1 pour toucher, s&apos;applique toujours.</characteristic>
      </characteristics>
    </profile>
    <profile name="Canon Tracté" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="d2a6-dafd-568e-a99a">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">30&quot;</characteristic>
