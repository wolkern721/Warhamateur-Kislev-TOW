        <characteristic name="Special Rules" typeId="5f83-3633-336b-93b4">Move or Shoot, Armour Bane (1), Cannon Fire, Cumbersome, Multiple Wounds (D3)</characteristic>
        <characteristic name="Notes" typeId="772a-a7ff-f6b3-df71"/>
      </characteristics>
    </profile>
    <profile name="Grand Grom" typeId="a378-c633-912d-11ce" typeName="Weapon" hidden="false" id="e65a-1144-f720-a3c4">
      <characteristics>
        <characteristic name="R" typeId="2360-c777-5e07-ed58">48&quot;</characteristic>
        <characteristic name="S" typeId="ac19-f99c-72e9-a1a7">10</characteristic>
