    </profile>
    <profile name="Lore of Ice" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="81f2-4525-5233-31e7">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">A Wizard with the &apos;Lore of Ice&apos; special rule may discard one of their randomly generated spells as normal. When they do so, they may select instead either the signature spell of their chosen Lore of Magic, or one of the spells listed below.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rafale de Vent" typeId="8232-ae14-b1f6-b4df" typeName="Spell" hidden="false" id="f877-eaf5-2d94-681a">
      <characteristics>
        <characteristic name="Number" typeId="8a2b-690b-e552-6aa0">1</characteristic>
        <characteristic name="Type" typeId="c2ca-5fd1-5e9d-bc90">Magic Missile</characteristic>
        <characteristic name="Casting Value" typeId="d84d-3b8b-654a-9e1a">8+/12+</characteristic>
        <characteristic name="Range" typeId="1043-a0ad-2909-dd28">24&quot;</characteristic>
        <characteristic name="Effect" typeId="64ba-31-acf0-5a">8+ : L&apos;unité ennemie ciblée subit 1d6+2 touches F4 Pa-1.
12+ : l&apos;unité ennemie ciblée subit 1d6+4 touches F4 Pa-1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armure de Magie de Glace" typeId="8232-ae14-b1f6-b4df" typeName="Spell" hidden="false" id="c9b8-9b24-1e30-d1db">
      <characteristics>
        <characteristic name="Number" typeId="8a2b-690b-e552-6aa0">2</characteristic>
        <characteristic name="Type" typeId="c2ca-5fd1-5e9d-bc90">Enchantment</characteristic>
        <characteristic name="Casting Value" typeId="d84d-3b8b-654a-9e1a">8+</characteristic>
        <characteristic name="Range" typeId="1043-a0ad-2909-dd28">12&quot;</characteristic>
        <characteristic name="Effect" typeId="64ba-31-acf0-5a">L&apos;unité ciblée améliore son armure de 1 jusqu&apos;à un maximum de 3+.
Si elle n&apos;en possédait pas, elle gagne une armure 6+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Morsure du Givre" typeId="8232-ae14-b1f6-b4df" typeName="Spell" hidden="false" id="60b2-083a-51c4-ffb0">
      <characteristics>
        <characteristic name="Number" typeId="8a2b-690b-e552-6aa0">3</characteristic>
        <characteristic name="Type" typeId="c2ca-5fd1-5e9d-bc90">Hex</characteristic>
        <characteristic name="Casting Value" typeId="d84d-3b8b-654a-9e1a">10+</characteristic>
        <characteristic name="Range" typeId="1043-a0ad-2909-dd28">21&quot;</characteristic>
        <characteristic name="Effect" typeId="64ba-31-acf0-5a">10 + : L&apos;unité ennemie ciblée subit un malus de -1 à sa caractéristique de Mvt, de Cc, de Ct ou de son Initiative (Choisissez avant de jeter les dès).
12+ : les 4 caractéristiques sont touchées (effectuez un seul jet)</characteristic>
      </characteristics>
    </profile>
    <profile name="Appel de la Vedma" typeId="8232-ae14-b1f6-b4df" typeName="Spell" hidden="false" id="9db8-33f6-6790-41e7">
      <characteristics>
        <characteristic name="Number" typeId="8a2b-690b-e552-6aa0">1</characteristic>
        <characteristic name="Type" typeId="c2ca-5fd1-5e9d-bc90">Enchantment/Hex</characteristic>
        <characteristic name="Casting Value" typeId="d84d-3b8b-654a-9e1a">11+</characteristic>
        <characteristic name="Range" typeId="1043-a0ad-2909-dd28">12&quot;</characteristic>
        <characteristic name="Effect" typeId="64ba-31-acf0-5a">Actif jusqu&apos;à la prochaine sous-phase de début de
tour du joueur.
Enchantement : l&apos;unité alliée ciblée voit son
Endurance être améliorée de 1 (jusqu&apos;à un maximum de 5).
Malédiction : l&apos;unité ennemie ciblée voit son
Endurance être réduite de 1 (jusqu&apos;à un minimum de 2).
Ce sortilège peut être utiliser sur un régiment engagé au Corps à Corps</characteristic>
      </characteristics>
    </profile>
    <profile name="Lore of Vedma" typeId="c1ac-c1c8-f9d5-9673" typeName="Special Rule" hidden="false" id="3152-2991-b3b7-5011">
      <characteristics>
        <characteristic name="Description" typeId="9f84-4221-785a-db50">A Wizard with the &apos;Lore of Vedma&apos; special rule may discard one of their randomly generated spells as normal. When they do so, they may select instead either the signature spell of their chosen Lore of Magic, or one of the spells listed below.</characteristic>
